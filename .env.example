# ---------------------------------------------------------------
# ZAYTOUN — benötigte Umgebungsvariablen
# Kopie als .env.local anlegen und mit echten Werten füllen.
# In Vercel unter Settings -> Environment Variables eintragen.
# ---------------------------------------------------------------

# Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Öffentliche Basis-URL der Seite (für Open Graph und Checkout-Rückleitungen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
