# ---------------------------------------------------------------
# ZAYTOUN — Umgebungsvariablen
#
# Alle Werte sind OPTIONAL. Ohne sie läuft die Seite vollständig:
# Der Warenkorb funktioniert, nur der Bezahlvorgang meldet dann
# freundlich, dass der Onlinekauf noch nicht freigeschaltet ist.
#
# Für lokale Arbeit: Kopie als .env.local anlegen.
# Für Vercel: unter Settings -> Environment Variables eintragen.
# ---------------------------------------------------------------

# Stripe — sobald ein Konto besteht: Dashboard -> Developers -> API keys.
# Bis dahin leer lassen.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Eigene Domain, sobald vorhanden, z. B. https://zaytoun.de
# Bleibt sie leer, wird automatisch die Vercel-Adresse des Projekts
# verwendet (lokal: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
